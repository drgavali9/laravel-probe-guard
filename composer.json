{
    "name": "drgavali9/laravel-probe-guard",
    "description": "Block suspicious URL probes and temporarily deny repeat offenders in Laravel applications.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "security",
        "middleware",
        "ip-blocking",
        "threat-detection"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "filament/filament": "^4.0|^5.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "suggest": {
        "filament/filament": "Required only when registering the optional Filament management resource."
    },
    "autoload": {
        "psr-4": {
            "ProbeGuard\\LaravelProbeGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ProbeGuard\\LaravelProbeGuard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ProbeGuard\\LaravelProbeGuard\\RequestGuardServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
